# Public listener (the UI / nginx talk to this) and internal listener (service-to-service, needs x-internal-secret)
GATEWAY_PORT=8100
GATEWAY_PRIVATE_PORT=8101
NATS_URL=nats://127.0.0.1:4222
# Must match every service that trusts gateway-forwarded claims / calls through the internal listener
GATEWAY_SECRET=dev-gateway-secret
INTERNAL_SECRET=dev-internal-secret
JWT_SECRET=dev-secret-change-me
# Extracted prefixes that return 503 (instead of falling back to core) when their owner is down
GATEWAY_RESERVED=/api/v1/notifications,/api/v1/search
