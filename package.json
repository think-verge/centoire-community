{
  "name": "centoire-platform",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/bahamut",
    "packages/contracts",
    "services/*",
    "extension"
  ],
  "scripts": {
    "build:packages": "npm run build -w @centoire/contracts -w @centoire/bahamut",
    "postinstall": "npm run build:packages",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  }
}
