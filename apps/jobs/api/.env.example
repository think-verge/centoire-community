# jobs-api — local development defaults. In dev, MONGODB_URI / JWT_SECRET / AI_INTERNAL_SECRET are
# borrowed from backend/.env automatically; set them here only to override.
PORT=8010
HOST=127.0.0.1
JOBS_DB_NAME=centoire_jobs
# Core API used for user lookups (x-internal-secret).
CORE_API_URL=http://127.0.0.1:8000
# Origins allowed to call this API with credentials (main app + jobs web).
CLIENT_ORIGINS=http://localhost:5173,http://localhost:5174
# Production session verification (RS256): core's JWKS endpoint, e.g. https://centoire.com/api/v1/auth/.well-known/jwks.json
# JWKS_URL=
# "admin_only" (launch) or "open"
COMPANY_CREATION=admin_only
JOB_TTL_DAYS=30
