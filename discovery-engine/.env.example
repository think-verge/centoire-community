MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=discovery_engine
SOURCES_FILE=sources.yaml

# Poll intervals per tier, in seconds
INTERVAL_FAST=180
INTERVAL_NORMAL=600
INTERVAL_SLOW=1800

# Minimum gap between Reddit requests (Reddit rate-limits unauthenticated clients)
REDDIT_GAP_SECONDS=30

# Instagram (see docs/instagram-setup.md). IG_USER_ID / IG_ACCESS_TOKEN are written
# by `python -m scripts.instagram_setup`; Instagram accounts are skipped until set.
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v25.0
IG_USER_ID=
IG_ACCESS_TOKEN=
IG_MAX_CALLS_PER_HOUR=180
IG_POSTS_PER_CALL=12
IG_INTERVAL_FAST=600
IG_INTERVAL_NORMAL=1800
IG_INTERVAL_SLOW=3600

# Stories: Gemini triages every article and groups them by event (off when the key is empty)
GEMINI_API_KEY=
# STORY_TRIAGE_MODEL=gemini-3.5-flash-lite
# STORY_MATCH_MODEL=gemini-3.5-flash
# EMBED_MODEL=gemini-embedding-001

# Centoire app: review queue + shared sources (app.review). Off when unset.
CENTOIRE_API_URL=http://127.0.0.1:8000/api/v1
# Must equal the backend's DISCOVERY_INTERNAL_SECRET (its dev default is this value)
CENTOIRE_DISCOVERY_SECRET=dev-discovery-secret
